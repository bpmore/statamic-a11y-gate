{
    "name": "bpmore/statamic-a11y-gate",
    "description": "Refuses to publish a Statamic entry that fails the accessibility checks it can actually run.",
    "keywords": ["statamic", "accessibility", "a11y", "wcag"],
    "license": "proprietary",
    "type": "statamic-addon",
    "homepage": "https://hada.farm",
    "authors": [
        {
            "name": "Brent Passmore",
            "homepage": "https://hada.farm"
        }
    ],
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/bpmore"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "statamic/cms": "^6.27"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "ext-intl": "Normalises accented and full-width link text before it is compared, so \"Ｃｌｉｃｋ ｈｅｒｅ\" is caught like \"click here\"."
    },
    "autoload": {
        "psr-4": {
            "Bpmore\\A11yGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bpmore\\A11yGate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "statamic": {
            "name": "Accessibility Gate",
            "slug": "statamic-a11y-gate"
        },
        "laravel": {
            "providers": [
                "Bpmore\\A11yGate\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
